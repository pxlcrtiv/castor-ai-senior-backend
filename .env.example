# =============================================================================
# Castor AI — Environment Configuration
# =============================================================================
# Copy this to .env and fill in your values.
# Only the provider you select needs its vars set.

# --- Provider Selection ---
# Options: openai | gemini | opencode-zen | vercel-ai
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# --- Google Gemini ---
# GEMINI_API_KEY=AIza-your-key-here
# GEMINI_MODEL=gemini-2.0-flash

# --- OpenCode Zen (OpenAI-compatible) ---
# ZEN_API_KEY=your-zen-key
# ZEN_BASE_URL=https://api.zen.example.com/v1
# ZEN_MODEL=zen-pro

# --- Vercel AI Gateway (OpenAI-compatible, routes to any model) ---
# VERCEL_AI_API_KEY=your-vercel-key
# VERCEL_AI_BASE_URL=https://ai-gateway.vercel.com/v1
# VERCEL_AI_MODEL=anthropic/claude-3.5-sonnet

# --- Shared ---
# LLM_TEMPERATURE=0.1
