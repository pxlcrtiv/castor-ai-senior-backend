%%{init: {'theme': 'base', 'themeVariables': {'primaryColor': '#1a1a2e', 'primaryTextColor': '#eee', 'primaryBorderColor': '#e94560', 'lineColor': '#e94560', 'secondaryColor': '#16213e', 'tertiaryColor': '#0f3460'}}}%%

flowchart TD
    %% User Layer
    USER([👤 User<br/>Portal Angular])
    VALIDATOR{🛡️ Security Layer<br/>Prompt Injection<br/>+ PII Check}

    %% Agent Layer
    ORCHESTRATOR[🤖 Conciliator<br/>AutoGen Multi-Agent<br/>GroupChat]
    ERP_AGENT[📊 ERP Analyst<br/>SQL + Tax Tools]
    COMPLIANCE[📋 Compliance Officer<br/>RAG + Regulations]

    %% Tools Layer
    ERP[🗄️ SQL Tool<br/>get_erp_data<br/>Mock SQL Server]
    TAX[🧮 Tax Tool<br/>calculate_tax_discrepancy<br/>Tax Logic]
    PENDING[📋 list_pending_invoices<br/>Pending Invoices]

    %% RAG Layer
    RAG[📚 RAG Pipeline<br/>Metadata Filtering<br/>ChromaDB + Embeddings]
    PDFS[📄 PDF Manuals<br/>Regulations 2024]
    REGS[(🏛️ Regulations<br/>Tax Code<br/>Manuals)]

    %% Decision Layer
    DECISION{⚖️ Decision<br/>Human or<br/>ERP Adjustment?}
    HUMAN([👨‍💼 Notify<br/>Human])
    ERP_ACTION[📝 Generate<br/>ERP Adjustment]

    %% Memory
    MEMORY[(🧠 Session Memory<br/>Conversational<br/>Buffer)]

    %% Guardrails
    GUARDRAILS[🔒 Guardrails<br/>• No salary leaks<br/>• No auto-approve > $10K<br/>• Audit trail<br/>• Output sanitization]

    %% Flow
    USER -->|Query| VALIDATOR
    VALIDATOR -->|✅ Safe| ORCHESTRATOR
    VALIDATOR -->|❌ Blocked| USER

    ORCHESTRATOR --> ERP_AGENT
    ORCHESTRATOR --> COMPLIANCE

    ERP_AGENT --> ERP
    ERP_AGENT --> TAX
    ERP_AGENT --> PENDING

    COMPLIANCE --> RAG

    RAG <--> REGS
    PDFS -.->|Index| RAG

    ERP --> ERP_AGENT
    TAX --> ERP_AGENT
    PENDING --> ERP_AGENT
    RAG --> COMPLIANCE

    ERP_AGENT --> ORCHESTRATOR
    COMPLIANCE --> ORCHESTRATOR

    ORCHESTRATOR --> DECISION
    DECISION -->|Escalate| HUMAN
    DECISION -->|Approved| ERP_ACTION

    ORCHESTRATOR -.-> GUARDRAILS
    GUARDRAILS -.->|Sanitize| USER

    %% Styling
    classDef userStyle fill:#e94560,stroke:#1a1a2e,color:#fff
    classDef agentStyle fill:#0f3460,stroke:#e94560,color:#fff
    classDef toolStyle fill:#16213e,stroke:#0f3460,color:#eee
    classDef ragStyle fill:#533483,stroke:#e94560,color:#fff
    classDef decisionStyle fill:#f39c12,stroke:#e74c3c,color:#1a1a2e
    classDef securityStyle fill:#c0392b,stroke:#e74c3c,color:#fff
    classDef memoryStyle fill:#2c3e50,stroke:#3498db,color:#eee

    class USER userStyle
    class ORCHESTRATOR,ERP_AGENT,COMPLIANCE agentStyle
    class ERP,TAX,PENDING toolStyle
    class RAG,PDFS,REGS ragStyle
    class DECISION,HUMAN,ERP_ACTION decisionStyle
    class VALIDATOR,GUARDRAILS securityStyle
    class MEMORY memoryStyle
